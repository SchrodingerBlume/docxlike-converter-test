{
  "name": "docxlike-web",
  "version": "0.1.0",
  "description": "Browser-based DOCX to docxlike LaTeX converter (WebAssembly)",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/e2e-convert.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets": "python3 scripts/build-assets.py",
    "postinstall": "node scripts/sync-pyodide.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:ai": "node scripts/browser-ai-test.mjs"
  },
  "keywords": [
    "docx",
    "latex",
    "wasm",
    "pyodide"
  ],
  "author": "吴俊豪 <andrew.junhao.wu@gmail.com>",
  "license": "LPPL-1.3c",
  "type": "module",
  "private": true,
  "dependencies": {
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
