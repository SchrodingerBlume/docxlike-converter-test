\tl_const:Nn \c__docxlike_luatexja_tested_tl { 20260517.0 }
\tl_new:N \l__docxlike_luatexja_bad_tl
\msg_new:nnnn { docxlike } { luatexja-contract }
  { luatexja~#1~lacks~internals~that~docxlike~reads:~#2. }
  {
    CJK~line~breaking~and~spacing~will~not~follow~Word.~docxlike~was~tested~with~luatexja~#3;~
    report~this~message~with~both~versions.
  }
\msg_new:nnnn { docxlike } { luatexja-version }
  { luatexja~#1~is~not~the~version~docxlike~was~tested~with~(#2). }
  {
    The~luatexja~internals~docxlike~reads~were~all~found,~but~CJK~spacing~may~still~differ;~
    report~a~layout~change~with~both~versions.
  }
\cs_new_protected:Npn \__docxlike_luatexja_check:
  {
    \lua_now:n
      {
        docxlike.ltj = docxlike.runtime.load("ltj")
        token.set_macro("l__docxlike_luatexja_bad_tl", table.concat(docxlike.ltj.check(),",~"))
      }
    \clist_map_inline:nn
      { ltjsetparameter , ltjdefcharrange , ltjjachar , ltjfakeboxbdd , ltj@curjfnt }
      {
        \cs_if_exist:cF {##1}
          {
            \tl_put_right:Ne \l__docxlike_luatexja_bad_tl
              { \tl_if_empty:NF \l__docxlike_luatexja_bad_tl { ,~ } \c_backslash_str ##1 }
          }
      }
    \tl_if_empty:NTF \l__docxlike_luatexja_bad_tl
      {
        \tl_if_eq:NNF \LuaTeXjaversion \c__docxlike_luatexja_tested_tl
          {
            \msg_warning:nnee { docxlike } { luatexja-version }
              { \exp_not:V \LuaTeXjaversion } { \c__docxlike_luatexja_tested_tl }
          }
      }
      {
        \msg_error:nneee { docxlike } { luatexja-contract }
          { \cs_if_exist:NTF \LuaTeXjaversion { \exp_not:V \LuaTeXjaversion } { (unknown~version) } }
          { \exp_not:V \l__docxlike_luatexja_bad_tl } { \c__docxlike_luatexja_tested_tl }
      }
  }
\sys_if_engine_luatex:T
  {
    \AddToHook { begindocument }
      { \cs_if_exist:NT \ltjsetparameter { \__docxlike_luatexja_check: } }
  }
