end
function P.note(insertion)
  if not flag('g__docxlike_page_configured_bool') then return end
  local geometry = snapshot()
  for line in node.traverse_id(H, insertion.list) do
    local p = node.getproperty(line) or {}
    if not p.docxlike_page_geometry then
      p.docxlike_page_geometry = geometry
      node.setproperty(line, p)
    end
  end
end
local function first_geometry(head)
  for n in node.traverse(head) do
    --[[ an empty box (a write or mark made before the break) does not decide the page's geometry ]]
    if (n.id == H or n.id == V) and (n.width ~= 0 or n.height ~= 0 or n.depth ~= 0) then
      local p = node.getproperty(n) or {}
      if p.docxlike_page_geometry then return p.docxlike_page_geometry end
      if n.list then
        local geometry = first_geometry(n.list)
        if geometry then return geometry end
      end
    end
  end
end
function P.prepare(index)
