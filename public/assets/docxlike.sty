  return p
end
function P.tag(box)
  if tex.nest.ptr ~= 0 or not flag('g__docxlike_page_configured_bool')
    or flag('l__docxlike_linebreak_output_bool') then return end
  local p = node.getproperty(box) or {}
  p.docxlike_page_geometry = snapshot()
  node.setproperty(box, p)
end
function P.tag_lines(head)
  if tex.nest.ptr == 0 then
    for n in node.traverse(head) do
      if n.id == H or n.id == V then P.tag(n)
      elseif n.id == INS and n.subtype == token.create('footins').mode then P.note(n) end
    end
  end
